  "components": {
    "schemas": {
      "ChatInput": {
        "properties": {
          "request_id": {
            "type": "string",
            "format": "uuid",
            "title": "Request Id"
          },
          "content": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Content"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request_id",
          "content"
        ],
        "title": "ChatInput"
      },
      "ConversationInput": {
        "properties": {
          "personality_id": {
            "type": "string",
            "format": "uuid",
            "title": "Personality Id"
          },
          "title": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "title": "Title",
            "default": "New conversation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "personality_id"
        ],
        "title": "ConversationInput"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "PersonalityInput": {
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 40,
            "minLength": 1,
            "pattern": "^[\\w .-]+$",
            "title": "Name",
            "default": "ADA"
          },
          "style": {
            "type": "string",
            "enum": [
              "direct",
              "conversational",
              "formal"
            ],
            "title": "Style",
            "default": "conversational"
          },
          "warmth": {
            "type": "string",
            "enum": [
              "reserved",
              "warm"
            ],
            "title": "Warmth",
            "default": "warm"
          },
          "detail": {
            "type": "string",
            "enum": [
              "concise",
              "balanced",
              "detailed"
            ],
            "title": "Detail",
            "default": "balanced"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "PersonalityInput"
      },
      "RequestOutput": {
        "properties": {
          "request_id": {
            "type": "string",
            "title": "Request Id"
          },
          "conversation_id": {
            "type": "string",
            "title": "Conversation Id"
          },
          "status": {
            "type": "string",
            "enum": [
              "running",
              "completed",
              "failed"
            ],
            "title": "Status"
          },
          "response": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response"
          },
          "error_code": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error Code"
          },
          "attempt": {
            "type": "integer",
            "title": "Attempt"
          },
          "provider": {
            "type": "string",
            "title": "Provider"
          },
          "model": {
            "type": "string",
            "title": "Model"
          },
          "input_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Input Tokens"
          },
          "output_tokens": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Output Tokens"
          }
        },
        "type": "object",
        "required": [
          "request_id",
          "conversation_id",
          "status",
          "response",
          "error_code",
          "attempt",
          "provider",
          "model",
          "input_tokens",
          "output_tokens"
        ],
        "title": "RequestOutput"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    }
  }
}
