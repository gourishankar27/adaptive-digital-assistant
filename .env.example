# Run Python/Ollama natively on Windows. PostgreSQL can run in Docker Desktop.
POSTGRES_PASSWORD=password
# URL-encode special characters in the password when constructing this URL.
ADA_DATABASE_URL=postgresql+psycopg://ada:password@127.0.0.1:5432/ada
ADA_PROVIDER=ollama
ADA_OLLAMA_URL=http://127.0.0.1:11434
ADA_OLLAMA_MODEL=qwen3.8:27b
ADA_CONTEXT_TOKENS=8192
ADA_OUTPUT_TOKENS=512
ADA_TIMEOUT_SECONDS=180
ADA_MAX_PARALLEL=1
# Deliberately conservative UTF-8 byte budget, not a tokenizer measurement.
ADA_PROMPT_BYTES=6000
