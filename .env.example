# Run Python/Ollama natively on Windows. PostgreSQL can run in Docker Desktop.
POSTGRES_PASSWORD=replace-with-a-long-random-password
# Host port for new installs; match it in ADA_DATABASE_URL below.
POSTGRES_PORT=5432
# URL-encode special characters in the password when constructing this URL.
ADA_DATABASE_URL=postgresql+psycopg://ada:replace-with-a-long-random-password@127.0.0.1:5432/ada
ADA_PROVIDER=ollama
ADA_OLLAMA_URL=http://127.0.0.1:11434
ADA_OLLAMA_MODEL=qwen3.8:27b
ADA_CONTEXT_TOKENS=8192
ADA_OUTPUT_TOKENS=512
ADA_TIMEOUT_SECONDS=180
ADA_MAX_PARALLEL=1
# Deliberately conservative UTF-8 byte budget, not a tokenizer measurement.
ADA_PROMPT_BYTES=6000
# Retrieval uses part of the whole prompt budget, not an additional allowance.
ADA_MEMORY_BYTES=2200
ADA_RETRIEVAL_LIMIT=8
# Phase 10 stays off pending real-model evaluation; installation needs schema 0007.
ADA_EMBEDDING_ENABLED=false
ADA_EMBEDDING_MODEL=embeddinggemma:300m
ADA_EMBEDDING_DIGEST=85462619ee721b466c5927d109d4cb765861907d5417b9109caebc4e614679f1
ADA_EMBEDDING_DIMENSIONS=768
ADA_EMBEDDING_TIMEOUT_SECONDS=10
ADA_EMBEDDING_MIN_SIMILARITY=0.7
# Phase 13 bounded lifespan worker; source installation requires schema 0010.
# Keep one Uvicorn worker; admission remains shared only within the process.
ADA_CONSOLIDATION_WORKER_ENABLED=true
# Phase 18 opt-in owner-authorized credential enrollment and explicit erasure.
# These settings never grant admin privileges or automatically expire private content.
ADA_DEVICE_ENROLLMENT_ENABLED=false
ADA_DELETION_WORKER_ENABLED=false
ADA_PRIVATE_READ_LIMIT_PER_MINUTE=2400
ADA_PRIVATE_WRITE_LIMIT_PER_MINUTE=600
ADA_PRIVATE_MAX_BODY_BYTES=524288

# Optional private HTTPS/password setup: docs/PRIVATE-SETUP-WINDOWS-TAILSCALE.md.
# Literal values only. Tailscale Serve manages TLS; no cert/key path is needed.
# ADA_BROWSER_ORIGIN=https://YOUR-NODE.YOUR-TAILNET.ts.net
# ADA_ADMIN_DIST=G:/your-checkout/apps/admin-web/dist
# Address reference metadata only; these do not bind services or grant access.
# ADA_TAILNET_HOST=YOUR-NODE.YOUR-TAILNET.ts.net
# ADA_TAILSCALE_IP=100.x.y.z
# ADA_LAPTOP_LAN_IP=192.168.1.10
# ADA_PHONE_LAN_IP=192.168.1.11
# ADA_IPAD_LAN_IP=192.168.1.12

# Phase24 is opt-in after actual host isolation verification; see docs/SECURE-WEB-RESEARCH.md.
ADA_WEB_RESEARCH_ENABLED=false
# Rebuild and verify this immutable image manifest on the installation host.
# ADA_WEB_BROKER_MANIFEST=G:/your-checkout/.pytest_cache/web-broker-image.json
# Public operator contact disclosed to Wikipedia only; omit to disable search.
# ADA_WEB_OPERATOR_CONTACT=your-public-contact@example.org

# Phase27: reviewed durable inbox schedules; installation requires schema0018.
# Owner consent is separate and off by default. Foreground in-app polling only;
# no background push provider/notification permission or second inference worker.
# See docs/DURABLE-SCHEDULING-AND-REMINDERS.md before enabling an installation.
ADA_SCHEDULER_ENABLED=false

# Phase28: initial reports/catalogue questions, never automatic factual acceptance.
# Requires schema0019, host measurements, both existing workers and separate owner consent.
# No background GPU summary class is enabled by this source-only installation.
# See docs/IDLE-REFLECTION-AND-DREAM-REVIEW.md.
ADA_REFLECTION_ENABLED=false
ADA_REFLECTION_SUMMARY_ENABLED=false
# ADA_REFLECTION_MODEL_DIGEST=<validated 64-character lowercase SHA-256>

# Phase31: verified local Docker parser required; see docs/PDF-INGESTION.md.
ADA_PDF_INGESTION_ENABLED=false
# ADA_PDF_PARSER_MANIFEST=G:/your-checkout/.pytest_cache/pdf-parser-image.json
# Phase19A receipt protocol only; tested model quality does not permit activation.
ADA_EDGE_DRAFT_SYNC_ENABLED=false
